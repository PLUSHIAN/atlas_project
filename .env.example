# Copie para .env na RAIZ do projeto e preencha SOMENTE na sua máquina.
# NUNCA compartilhe .env, inclua em ZIP, publique em repositório ou envie por chat.
SERPAPI_KEY=

# Agenda interna: exige backend ligado, mesmo com navegador fechado.
MONITOR_ENABLED=true
# Também pesquisar entrada por Roma e saída por Milão, ou vice-versa
OPEN_JAW_ENABLED=true
# 2 em cada 3 rodadas automáticas buscam Espanha (Barcelona/Madri)
SPAIN_PRIORITY=true
SCAN_INTERVAL_HOURS=8
MAX_REQUESTS_30D=210
CACHE_HOURS=12
# Até 2 retornos por rodada, segundo retorno somente a cada 4 pesquisas
MAX_RETURN_CHECKS_PER_SCAN=2

# Opcional: protege endpoints que iniciam busca e salvam estimativas.
# Em rede pública, use autenticação e HTTPS; local, mantenha 127.0.0.1.
APP_API_TOKEN=

# Alerta SMTP (Gmail: porta 587 e senha de aplicativo com 2FA ativo).
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=COLE_SUA_SENHA_DE_APLICATIVO_AQUI
SMTP_FROM=seu_email@gmail.com
ALERT_TO=seu_email@gmail.com
ALERT_MIN_DROP_PCT=5
ALERT_MIN_DROP_BRL=200

# Caminho do banco: vazio = padrão ./data/passagens.sqlite3
# DB_PATH=
